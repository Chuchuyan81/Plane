# Корпус босса (Wavefront OBJ). Замените файл при конвертации model.g3d.
mtllib model.mtl

o boss_hull
usemtl object_0

v -6.0 -2.5 -4.0
v 6.0 -2.5 -4.0
v 6.0 2.5 -4.0
v -6.0 2.5 -4.0
v -6.0 -2.5 4.0
v 6.0 -2.5 4.0
v 6.0 2.5 4.0
v -6.0 2.5 4.0

f 1 2 3
f 1 3 4
f 6 5 8
f 6 8 7
f 5 1 4
f 5 4 8
f 2 6 7
f 2 7 3
f 5 6 2
f 5 2 1
f 4 3 7
f 4 7 8
